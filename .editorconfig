root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{rs,py,pyi,nix,lean}]
max_line_length = 100

[*.md]
max_line_length = 150
trim_trailing_whitespace = false

[*.{yaml,yml,json,sh,toml}]
indent_size = 2

[Makefile]
indent_style = tab
